modules = ["python-3.11"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "deno"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "RichMP3"

[[workflows.workflow]]
name = "RichMP3"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python run_replit.py"

[workflows.workflow.metadata]
outputType = "console"
